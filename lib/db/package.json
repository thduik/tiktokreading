{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./ranking": "./src/ranking/index.ts"
  },
  "scripts": {
    "migrate": "tsx ./src/scripts/migrate.ts",
    "import:sample": "tsx ./src/scripts/import-passages.ts",
    "backfill:vocab": "tsx ./src/scripts/backfill-passage-vocab.ts",
    "parse:mixed-batch": "tsx ./src/scripts/parse-mixed-batch.ts",
    "redo:vocab-vi": "tsx ./src/scripts/redo-vocab-vietnamese.ts",
    "enrich:vocab-learning": "tsx ./src/scripts/enrich-vocab-learning-fields.ts",
    "scramble:mcq": "tsx ./src/scripts/scramble-mcq-answers.ts",
    "audit:answer-keys": "tsx ./src/scripts/audit-answer-key-anomalies.ts",
    "audit:question-paraphrase": "tsx ./src/scripts/audit-question-paraphrase.ts",
    "pretest": "node ../../scripts/check-toolchain.mjs --pnpm",
    "test": "tsx --test ./src/ranking/ranking.test.ts ./src/schema/migration-smoke.test.ts ./src/scripts/ingest-ndjson-cards.test.ts ./src/scripts/repair-v5-plus-multi-key-mcq.test.ts",
    "test:ranking": "tsx --test ./src/ranking/ranking.test.ts",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "catalog:"
  }
}
